<Window x:Class="ShoeStore.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО «Обувь» — вход"
        Height="620"
        Width="980"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource PageBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#101828">
            <Grid ClipToBounds="True">
                <Ellipse Width="460"
                         Height="460"
                         Fill="#B45309"
                         Opacity="0.20"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Margin="-180,0,0,-220">
                    <Ellipse.Effect>
                        <BlurEffect Radius="90" />
                    </Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="320"
                         Height="320"
                         Fill="#D97706"
                         Opacity="0.12"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-140,-120,0">
                    <Ellipse.Effect>
                        <BlurEffect Radius="80" />
                    </Ellipse.Effect>
                </Ellipse>

                <Grid Margin="44,48,44,40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="40"
                                Height="40"
                                CornerRadius="12"
                                Background="{StaticResource BrandGradientBrush}">
                            <TextBlock Text="&#xE719;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="18"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ООО «Обувь»"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="White" />
                            <TextBlock Text="Учёт заказов"
                                       FontSize="11.5"
                                       Foreground="#8FA0B8"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="Вся работа магазина"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock Text="в одном окне"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="#F0B37E"
                                   Margin="0,2,0,0" />
                        <TextBlock Text="Каталог, заказы и сотрудники — без переключения между таблицами и документами."
                                   FontSize="13"
                                   Foreground="#A9B4C6"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,14,0,0" />

                        <StackPanel Margin="0,30,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#1D2A3F">
                                    <TextBlock Text="&#xE73E;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="10"
                                               Foreground="#F0B37E"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Каталог товаров, цен и остатков"
                                           Foreground="#D5DCE7"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#1D2A3F">
                                    <TextBlock Text="&#xE73E;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="10"
                                               Foreground="#F0B37E"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Оформление и статусы заказов"
                                           Foreground="#D5DCE7"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#1D2A3F">
                                    <TextBlock Text="&#xE73E;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="10"
                                               Foreground="#F0B37E"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Роли, отделы и права доступа"
                                           Foreground="#D5DCE7"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Text="© 2026 ООО «Обувь» · внутренняя система"
                               FontSize="11"
                               Foreground="#6B7A90" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="White">
            <StackPanel Width="360"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="Вход в систему"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource DarkBrush}" />
                <TextBlock Text="Введите логин и пароль учётной записи."
                           FontSize="12.5"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,7,0,0" />

                <TextBlock Text="Логин"
                           Style="{StaticResource FieldLabel}"
                           Margin="0,28,0,0" />
                <TextBox x:Name="LoginBox"
                         Margin="0,7,0,0"
                         Height="42" />

                <TextBlock Text="Пароль"
                           Style="{StaticResource FieldLabel}"
                           Margin="0,16,0,0" />
                <PasswordBox x:Name="PasswordBox"
                             Margin="0,7,0,0"
                             Height="42" />

                <Border Background="#FEF2F2"
                        BorderBrush="#FECACA"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="12,10"
                        Margin="0,16,0,0"
                        Visibility="{Binding Visibility, ElementName=ErrorText}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource DangerBrush}"
                                   VerticalAlignment="Top"
                                   Margin="0,1,0,0" />
                        <TextBlock x:Name="ErrorText"
                                   Style="{StaticResource ErrorText}"
                                   Margin="8,0,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Button x:Name="LoginButton"
                        Content="Войти"
                        Height="44"
                        Margin="0,22,0,0"
                        IsDefault="True"
                        Click="Login_Click" />

                <Grid Margin="0,20,0,0">
                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" VerticalAlignment="Center" />
                    <Border Background="White" Padding="10,0" HorizontalAlignment="Center">
                        <TextBlock Text="или"
                                   FontSize="11.5"
                                   Foreground="{StaticResource SubtleBrush}" />
                    </Border>
                </Grid>

                <Button Height="42"
                        Margin="0,16,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Click="Guest_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77B;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Продолжить как гость"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock Text="Гостевой режим открывает только каталог товаров."
                           FontSize="11.5"
                           Foreground="{StaticResource SubtleBrush}"
                           TextAlignment="Center"
                           Margin="0,14,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
