<Window x:Class="ShoeStore.App.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар"
        Height="840"
        Width="700"
        MinHeight="640"
        MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource PageBackgroundBrush}">
    <Border Margin="18" Style="{StaticResource DialogCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Padding="28,24,28,6">
                <StackPanel>
                    <TextBlock x:Name="TitleText"
                               Text="Новый товар"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource DarkBrush}" />
                    <TextBlock Text="Заполните карточку товара — обязательные поля отмечены по смыслу формы."
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,8,28,0">

                    <TextBlock Text="Основные данные" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Артикул" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="SkuBox" Height="40" Margin="0,7,0,0" MaxLength="32" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Наименование" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="NameBox" Height="40" Margin="0,7,0,0" MaxLength="255" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Классификация" Style="{StaticResource SectionTitle}" Margin="0,24,0,0" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Категория" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="CategoryBox"
                                      Margin="0,7,0,0"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Поставщик" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="SupplierBox"
                                      Margin="0,7,0,0"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <TextBlock Text="Производитель" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ManufacturerBox"
                                      Margin="0,7,0,0"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                            <TextBlock Text="Единица измерения" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="UnitBox"
                                      Margin="0,7,0,0"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Цены и остатки" Style="{StaticResource SectionTitle}" Margin="0,24,0,0" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Цена, ₽" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="PriceBox" Height="40" Margin="0,7,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Скидка, %" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="DiscountBox" Height="40" Margin="0,7,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Остаток" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="StockBox" Height="40" Margin="0,7,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Описание" Style="{StaticResource SectionTitle}" Margin="0,24,0,0" />
                    <TextBox x:Name="DescriptionBox"
                             Height="110"
                             Margin="0,12,0,24"
                             Padding="11,9"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="#FCFAF7"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,15,15"
                    Padding="28,16,28,20">
                <StackPanel>
                    <Border Background="#FEF2F2"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="12,10"
                            Margin="0,0,0,14"
                            Visibility="{Binding Visibility, ElementName=ErrorText}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource DangerBrush}"
                                       VerticalAlignment="Top"
                                       Margin="0,1,0,0" />
                            <TextBlock x:Name="ErrorText"
                                       Style="{StaticResource ErrorText}"
                                       Margin="8,0,0,0"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена"
                                Height="42"
                                MinWidth="120"
                                Margin="0,0,10,0"
                                Style="{StaticResource SecondaryButton}"
                                IsCancel="True" />
                        <Button x:Name="SaveButton"
                                Content="Сохранить"
                                Height="42"
                                MinWidth="140"
                                IsDefault="True"
                                Click="Save_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
